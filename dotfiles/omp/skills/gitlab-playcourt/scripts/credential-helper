#!/usr/bin/env bash
# credential-helper — install the GitLab Playcourt git credential helper.
#
#   credential-helper            install/refresh the helper in ~/.gitconfig
#   credential-helper --remove   remove it
#
# The helper reads $PAT_GITLABPLAYCOURT at call time, so the token never lands in
# ~/.gitconfig, ~/.git-credentials, or any repo's .git/config. It requires the
# variable to be exported by the calling shell (~/.zshenv loads ~/.env).
set -euo pipefail

KEY='credential.https://gitlab.playcourt.id.helper'
HELPER='!f() { test "$1" = get && printf "username=oauth2\npassword=%s\n" "$PAT_GITLABPLAYCOURT"; }; f'

if [ "${1:-}" = "--remove" ]; then
    git config --global --unset-all "$KEY" 2>/dev/null || true
    echo "removed $KEY from ~/.gitconfig"
    exit 0
fi

git config --global --replace-all "$KEY" "$HELPER"

if grep -qs "PAT_GITLABPLAYCOURT" "$HOME/.env"; then
    echo "helper installed; PAT_GITLABPLAYCOURT found in ~/.env"
else
    echo "helper installed; WARNING: PAT_GITLABPLAYCOURT not found in ~/.env" >&2
fi

echo "verify: git ls-remote https://gitlab.playcourt.id/<group>/<repo>.git"
