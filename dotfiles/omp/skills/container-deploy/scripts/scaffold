#!/usr/bin/env bash
# scaffold — create ~/Deployments/<app> from the container-deploy templates.
#
#   scaffold <app> <container-port> [domain]
#
# Allocates the next free loopback port from 18080 upward, then renders
# deploy.sh, <app>.container, and <app>.caddyfile from templates/.
# Refuses to overwrite an existing deployment directory.
set -euo pipefail

APP="${1:?usage: scaffold <app> <container-port> [domain]}"
CPORT="${2:?container port required (the port the image listens on)}"
DOMAIN="${3:-$APP.keton.id}"
SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TPL="$SKILL_DIR/templates"
DEST="$HOME/Deployments/$APP"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[ -d "$TPL" ] || die "templates missing: $TPL"
[ -e "$DEST" ] && die "$DEST already exists"
case "$CPORT" in ''|*[!0-9]*) die "container port must be numeric" ;; esac

# Next free loopback port: highest existing 180xx + 1, verifying nothing listens.
# (if-statements instead of `&&` chains: a false test must not trip `set -e`.)
port=18080
for d in "$HOME"/Deployments/*/; do
    [ -d "$d" ] || continue
    p="$(grep -hoE '^PublishPort=127\.0\.0\.1:[0-9]+' "$d"*.container 2>/dev/null | sed 's/.*://' | sort -n | tail -1 || true)"
    if [ -n "$p" ] && [ "$p" -ge "$port" ]; then port=$((p + 1)); fi
done
while ss -ltn 2>/dev/null | grep -q ":$port "; do port=$((port + 1)); done

mkdir -p "$DEST"
render() { sed -e "s|__APP__|$APP|g" -e "s|__DOMAIN__|$DOMAIN|g" \
               -e "s|__PORT__|$port|g" -e "s|__CPORT__|$CPORT|g" "$1"; }

install -m 0755 "$TPL/deploy.sh" "$DEST/deploy.sh"
render "$TPL/app.container" > "$DEST/$APP.container"
render "$TPL/app.caddyfile" > "$DEST/$APP.caddyfile"

printf 'scaffolded %s\n  domain  : https://%s\n  upstream: 127.0.0.1:%s -> container :%s\n' \
    "$DEST" "$DOMAIN" "$port" "$CPORT"
printf 'next: cd %s && ./deploy.sh build && ./deploy.sh up\n' "$DEST"
