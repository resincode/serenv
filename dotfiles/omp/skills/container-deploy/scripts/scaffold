#!/usr/bin/env bash
# scaffold — create ~/Deployments/<app> from the xdiag deployment template.
#
#   scaffold <app> <container-port> [domain]
#
# Allocates the next free loopback port starting at 18080, copies deploy.sh plus
# the quadlet and Caddy site templates, and rewrites app name, port, and domain.
# Idempotent: refuses to overwrite an existing deployment directory.
set -euo pipefail

APP="${1:?usage: scaffold <app> <container-port> [domain]}"
CPORT="${2:?container port required (the port the image listens on)}"
DOMAIN="${3:-$APP.keton.id}"
TEMPLATE="$HOME/Deployments/xdiag"
DEST="$HOME/Deployments/$APP"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[ -d "$TEMPLATE" ] || die "template deployment missing: $TEMPLATE"
[ -e "$DEST" ] && die "$DEST already exists"
case "$CPORT" in ''|*[!0-9]*) die "container port must be numeric" ;; esac

# Next free loopback port: highest existing 180xx + 1, verifying nothing listens.
port=18080
for d in "$HOME"/Deployments/*/; do
    [ -f "$d"*.container ] 2>/dev/null || continue
    p="$(grep -hoE '^PublishPort=127\.0\.0\.1:[0-9]+' "$d"*.container 2>/dev/null | sed 's/.*://' | sort -n | tail -1)"
    [ -n "${p:-}" ] && [ "$p" -ge "$port" ] && port=$((p + 1))
done
while ss -ltn 2>/dev/null | grep -q ":$port "; do port=$((port + 1)); done

mkdir -p "$DEST"
install -m 0755 "$TEMPLATE/deploy.sh"       "$DEST/deploy.sh"
install -m 0644 "$TEMPLATE/xdiag.container" "$DEST/$APP.container"
install -m 0644 "$TEMPLATE/xdiag.caddyfile" "$DEST/$APP.caddyfile"

sed -i \
    -e "s|PublishPort=127\.0\.0\.1:[0-9]*:[0-9]*|PublishPort=127.0.0.1:$port:$CPORT|" \
    -e "s|ContainerName=xdiag|ContainerName=$APP|" \
    -e "s|^Description=xdiag .*|Description=$APP container|" \
    -e "s|Image=localhost/xdiag:latest|Image=localhost/$APP:latest|" \
    "$DEST/$APP.container"

sed -i \
    -e "s|^xdiag\.keton\.id {|$DOMAIN {|" \
    -e "s|127\.0\.0\.1:18080|127.0.0.1:$port|" \
    "$DEST/$APP.caddyfile"

printf 'scaffolded %s\n  domain  : https://%s\n  upstream: 127.0.0.1:%s -> container :%s\n' \
    "$DEST" "$DOMAIN" "$port" "$CPORT"
printf 'next: cd %s && ./deploy.sh build && ./deploy.sh up\n' "$DEST"
