{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Shell }} | {{ .Env.USER }} @ {{ .Env.OMP_MODEL }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "white",
          "background": "transparent",
          "template": "┌─"
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "green",
          "background": "transparent",
          "template": " {{ .Env.USER }} 👤"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "white",
          "background": "transparent",
          "template": "  🤖 "
        },
        {
          "type": "env",
          "style": "plain",
          "foreground": "magenta",
          "background": "transparent",
          "template": "{{ .Env.OMP_MODEL }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "white",
          "background": "transparent",
          "template": "│  📁 "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "cyan",
          "background": "transparent",
          "template": "{{ .Path }}",
          "properties": {
            "home_icon": "~",
            "style": "mixed"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "yellow",
          "background": "transparent",
          "foreground_templates": [
            "{{ if or .Working.Changed .Staging.Changed }}red{{ end }}"
          ],
          "template": "  ⎇ {{ .HEAD }}{{ if .Working.Changed }} ✗{{ end }}{{ if .Staging.Changed }} ✓{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}",
          "properties": {
            "fetch_status": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "white",
          "background": "transparent",
          "template": "└─"
        },
        {
          "type": "command_execution_time",
          "style": "plain",
          "foreground": "yellow",
          "background": "transparent",
          "template": " {{ .FormattedMs }}",
          "properties": {
            "threshold": 2000,
            "style": "round"
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}red{{ else }}green{{ end }}"
          ],
          "background": "transparent",
          "template": " ❯"
        },
        {
          "type": "text",
          "style": "plain",
          "background": "transparent",
          "template": " "
        }
      ]
    }
  ]
}
