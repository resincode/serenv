# ============================================================================
# ZSH CONFIGURATION - OPSI 3 (FULL POWER SETUP)
# User: res | Environment: Alpine Linux 3.22 | Terminal: herdr
# ============================================================================

# ── Auto-attach tmux on SSH (atomic attach-or-create) ────────────────────────
# Only start persistent tmux on interactive SSH sessions (interactive shell + TTY).
# Non-interactive SSH commands (e.g. ssh host "cmd", scp, sftp) will NOT launch tmux.
if [[ -o interactive && -t 0 && -t 1 && ( -n "$SSH_CONNECTION" || -n "$SSH_TTY" || -n "$SSH_CLIENT" ) && -z "$TMUX" ]]; then
    exec tmux new-session -A -s metra2
fi
# ─────────────────────────────────────────────────────────────────────────────

# ---- Environment ----
export TERM=xterm-256color
export HISTSIZE=10000
export SAVEHIST=10000
export HISTFILE=~/.zsh_history
export PATH="$HOME/.local/bin:$PATH"

# ---- History Settings ----
setopt APPEND_HISTORY           # Append history instead of overwrite
setopt EXTENDED_HISTORY         # Save timestamps
setopt HIST_FIND_NO_DUPS        # Hide duplicates in history search
setopt HIST_IGNORE_ALL_DUPS     # Remove duplicates from history
setopt HIST_IGNORE_SPACE        # Don't save commands starting with space
setopt SHARE_HISTORY            # Share history between sessions

# ---- Completion ----
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors '${(s.:.)LS_COLORS}'
zstyle ':completion:*' verbose yes
zstyle ':completion:*:descriptions' format '%B%d%b'
zstyle ':completion:*:messages' format '%d'
zstyle ':completion:*:warnings' format 'No matches: %d'

# ---- Keyboard Bindings (Emacs mode) ----
bindkey -e
bindkey '\e[H' beginning-of-line
bindkey '\e[F' end-of-line
bindkey '^w' backward-kill-word
bindkey '^u' backward-kill-line
bindkey '^k' kill-line
bindkey '^l' clear-screen
bindkey '^f' forward-word
bindkey '^b' backward-word
bindkey '\e.' insert-last-word

# ============================================================================
# ALIASES
# ============================================================================

# File listing (using exa)
alias ls='exa'
alias ll='exa -lah'
alias la='exa -la'
alias l='exa -lF'
alias tree='exa --tree'

# Utilities (using better replacements)
alias cat='bat --paging=never'
alias grep='rg'
alias clip='xclip -selection clipboard'
alias paste='xclip -selection clipboard -o'
alias reload='source ~/.zshrc'

# Directory navigation
alias cls='clear'
alias ..='cd ..'
alias ...='cd ../..'

# System
alias top='htop'

# Git
alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'
alias gl='git log --oneline'
alias gd='git diff'

# omp/Claude Code specific
alias agents='ps aux | grep -E "python|node|omp" | grep -v grep'
alias logs='tail -f ~/.omp/logs/* 2>/dev/null || echo "No omp logs yet"'
alias omp-status='echo "=== omp Agents ===" && ps aux | grep omp | grep -v grep && echo "" && echo "=== Recent Logs ===" && tail -5 ~/.omp/logs/* 2>/dev/null || echo "No logs yet"'

# ============================================================================
# FUNCTIONS
# ============================================================================

# Quick directory jumping
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Show path nicely
show_path() {
    echo $PATH | tr ':' '\n' | nl
}

# Extract any archive
extract() {
    case "$1" in
        *.tar.gz) tar xzf "$1" ;;
        *.tar) tar xf "$1" ;;
        *.zip) unzip "$1" ;;
        *.gz) gunzip "$1" ;;
        *.bz2) bunzip2 "$1" ;;
        *) echo "Unknown archive type: $1" ;;
    esac
}

# Quick backup
backup() {
    cp "$1" "$1.backup.$(date +%s)"
}

# Git quick commands (if not aliased)
gst() { git status; }
gac() { git add "$@" && git commit -m "Quick commit"; }

# omp helpers
omp-kill() {
    pkill -f "^omp|python.*omp"
}

watch-omp() {
    watch -n 1 'ps aux | grep omp | grep -v grep'
}

# System info
sysinfo() {
    echo "=== System Info ==="
    echo "Kernel: $(uname -r)"
    echo "Uptime: $(uptime)"
    echo "Memory: $(free -h 2>/dev/null | awk 'NR==2 {print $2, "total,", $3, "used"}' || echo 'N/A')"
    echo "Disk: $(df -h / 2>/dev/null | awk 'NR==2 {print $2, "total,", $3, "used"}' || echo 'N/A')"
}

# ============================================================================
# CONTINUATION PROMPTS (main prompt handled by Powerlevel10k)
# ============================================================================

setopt PROMPT_SUBST
PS2='  %F{white}│%f '
PS3='?# '
PS4='+ '

# ============================================================================
# POWERLEVEL10K THEME (Opsi 3 addition)
# ============================================================================

# Check if Powerlevel10k is installed
if [ -d ~/.powerlevel10k ] && [ -f ~/.powerlevel10k/powerlevel10k.zsh-theme ]; then
    if source ~/.powerlevel10k/powerlevel10k.zsh-theme 2>/dev/null; then
        # Load Powerlevel10k config (3-line theme). p10k does NOT auto-read
        # ~/.p10k.zsh; it must be sourced explicitly right after the theme.
        [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
    fi
fi

# ============================================================================
# ZINIT PLUGIN MANAGER & PLUGINS (Opsi 3 addition)
# ============================================================================
if [[ -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    if source $HOME/.local/share/zinit/zinit.git/zinit.zsh 2>/dev/null; then
        # Fast syntax highlighting
        zinit ice lucid wait
        zinit light zdharma-continuum/fast-syntax-highlighting
        
        # Auto-suggestions (like fish shell)
        zinit ice lucid wait
        zinit light zsh-users/zsh-autosuggestions
        
        # Better completion
        zinit ice lucid wait
        zinit light zsh-users/zsh-completions
        
        # fzf integration (fuzzy finder)
        zinit ice lucid wait
        zinit light Aloxaf/fzf-tab
        
        # fzf key bindings (only in a real interactive TTY)
        if command -v fzf &> /dev/null && [[ -t 0 ]] && [[ -o interactive ]]; then
            source <(fzf --zsh) 2>/dev/null
        fi
        
        # Quick cd with z command
        zinit ice lucid wait
        zinit light agkozak/zsh-z
    fi
fi

# ============================================================================
# FZF CONFIGURATION (Opsi 3 - Fuzzy Finder)
# ============================================================================

if command -v fzf &> /dev/null; then
    # Ctrl+r = reverse history search (fzf)
    # Ctrl+t = find file (fzf)
    # Alt+c = cd into directory (fzf)
    
    # Custom fzf options
    export FZF_DEFAULT_OPTS='--height 40% --reverse --border'
fi

# ============================================================================
# SYNTAX HIGHLIGHTING COLORS (if using fast-syntax-highlighting)
# ============================================================================

export ZSH_HIGHLIGHT_STYLES=(
    'comment:fg=gray'
    'builtin:fg=blue,bold'
    'function:fg=green'
    'command:fg=cyan'
    'keyword:fg=yellow,bold'
)

# ============================================================================
# LS COLORS
# ============================================================================

export LS_COLORS='di=34:ln=36:or=31:mi=31:ex=32:*.gz=35:*.tar=35:*.zip=35'

# ============================================================================
# END OF ZSH CONFIG
# ============================================================================

# ============================================================================
# MARKDOWN VIEWING HELPERS (Added for documentation)
# ============================================================================

# Function to view markdown files beautifully
md() {
    if [ $# -eq 0 ]; then
        echo "Usage: md <filename>"
        echo "Example: md README.md"
        return 1
    fi
    
    # Try to use bat with less if available
    if command -v bat &>/dev/null; then
        bat "$@" | less -R
    else
        cat "$@" | less
    fi
}

# List all documentation files
docs() {
    echo "📚 Documentation Files Available:"
    echo ""
    ls -1 *.md 2>/dev/null | nl -w1 -s'. ' || echo "No .md files found"
    echo ""
    echo "Usage: md <filename>"
    echo "Example: md README.md"
    echo "        md 05-SSH_NETWORKING.md"
}

# Quick readme
readme() {
    md README.md
}

# Search in all documentation
docsearch() {
    if [ $# -eq 0 ]; then
        echo "Usage: docsearch <keyword>"
        echo "Example: docsearch 'ssh'"
        return 1
    fi
    rg "$1" *.md --color=always | less -R
}

